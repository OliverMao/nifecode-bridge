{
  "name": "nifecode-bridge",
  "version": "0.2.0",
  "description": "让 Nife 知道本机的 NifeCode 编辑器正开着什么：注册 nifecode 工具，编辑器在跑时把实时状态注入上下文（走 context 事件，不动 system prompt）；写文件前自动保存用户未保存的改动，写完后自动滚到改动行。编辑器没开就完全静默。",
  "scripts": {
    "test": "node extensions/state.test.mjs && node extensions/config.test.mjs"
  },
  "license": "GPL-3.0-or-later",
  "author": "OliverMao",
  "keywords": [
    "pi-package",
    "nifecode",
    "editor",
    "bridge",
    "tauri"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "nife-coding-agent": "*",
    "typebox": "*"
  },
  "files": [
    "extensions",
    "!extensions/*.test.mjs",
    "README.md",
    "LICENSE",
    "COPYRIGHT"
  ]
}
